# 复制为 .env 后按需修改；所有配置均可通过环境变量覆盖

# ===== 通用 =====
# 启用的引擎（逗号分隔：digital=文字层直提, dots=dots.ocr, paddle=PaddleOCR）
OCRS_ENGINES=digital,dots,paddle
# 引擎执行方式：auto（默认，按当前可用内存自动判定：双引擎工作集装得下就并行、
# 装不下就串行，避免 16GB 机型 swap 拖慢）/ 1 强制并行 / 0 强制串行
# OCRS_PARALLEL=auto
# mock 模式：不加载真实模型，用假结果跑通全流程（调试/演示用）
# OCRS_MOCK=1
# 数据目录（任务文件、结果都存这里）
# OCRS_DATA_DIR=./data
# 单任务/分片最大页数 / 上传大小上限（MB）；大文档用 scripts/shard_pdf.py 切分片后分任务提交
# OCRS_MAX_PAGES=100
# OCRS_MAX_UPLOAD_MB=200

# ===== dots.ocr =====
# 模型权重目录（scripts/download_dots_weights.py 的下载目标）
# OCRS_DOTS_MODEL_PATH=./weights/DotsOCR
# 设备：auto（默认，Mac 上自动选 mps）/ mps / cuda / cpu
# OCRS_DOTS_DEVICE=auto
# 精度：auto（mps/cuda 用 bfloat16，cpu 用 float32）/ bfloat16 / float16 / float32
# OCRS_DOTS_DTYPE=auto
# 注意力实现：auto（默认 sdpa）/ sdpa / eager
# OCRS_DOTS_ATTN=auto
# 单页最大生成 token 数（调小可省内存，过长页面可能被截断）
# OCRS_DOTS_MAX_NEW_TOKENS=16384
# PDF 渲染 DPI 与输入像素上限（0 表示不限制；内存紧张时可设小，如 10035200）
# OCRS_DOTS_DPI=200
# OCRS_DOTS_MAX_PIXELS=0

# ===== PaddleOCR =====
# 设备：留空自动探测（有 CUDA 用 gpu:0，否则 cpu；Mac 必然 cpu）；也可手动指定 gpu:0
# OCRS_PADDLE_DEVICE=
# 精度/速度三档：accurate 官方默认全开 | balanced 关方向/矫正/文本行方向（保留公式，推荐电子 PDF）
#               fast 用 mobile 检测识别 + 关公式（CPU 数秒/页，适合纯文本快速比对）
# OCRS_PADDLE_PROFILE=accurate
# 公式识别：留空跟随 profile；0 强制关闭（CPU 上 FormulaNet-L 自回归解码极慢，M5 实测占单页耗时 90%+）；1 强制开启
# OCRS_PADDLE_FORMULA=
# 子模型下载源：留空自动（hf.co 不可达时自动切百度 BOS 源）；可手动设 bos / aistudio / huggingface
# PADDLE_PDX_MODEL_SOURCE=
